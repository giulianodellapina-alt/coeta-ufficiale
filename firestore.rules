rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }

    function isSuperUser() {
      // Check for owner emails OR the bootstrap matricolas
      return isSignedIn() && (
        request.auth.token.get('email', '').lower() == "giulianodellapina@gmail.com" ||
        request.auth.token.get('email', '').lower() == "nausica.cf@gmail.com" ||
        (exists(/databases/$(database)/documents/user_sessions/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "DPG917" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "DPG 917" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "FC918" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "FC 918"
        ))
      );
    }

    function isAdmin() {
      return isSuperUser() || (
        isSignedIn() && exists(/databases/$(database)/documents/user_sessions/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("role", "") == "admin" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "DPG917" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "DPG 917" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "FC918" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "FC 918"
        )
      );
    }

    function isResponsabile() {
      return isAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/user_sessions/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("role", "") == "responsabile" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("role", "") == "admin" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "BA906" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "BA 906" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "CEA913" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "CEA 913" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "FF943" ||
          get(/databases/$(database)/documents/user_sessions/$(request.auth.uid)).data.get("matricola", "") == "FF 943"
        )
      );
    }

    // Default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }

    match /user_sessions/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow list, delete: if isAdmin();
    }

    match /guards/{guardId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || isResponsabile();
      allow update: if isAdmin() || isResponsabile() || (
        isSignedIn() &&
        (request.resource.data.get('uid', '') == request.auth.uid || guardId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'lastLogin', 'isTracingAuthorized', 'lastLocation', 'lastLocationTimestamp'])
      );
      
      match /private/{doc} {
        allow read, write: if isAdmin() || isResponsabile() || (isSignedIn() && request.auth.uid == guardId);
      }
    }

    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isResponsabile() || (isSignedIn() && resource.data.guardId == request.auth.uid);
      allow delete: if isAdmin() || isResponsabile();
    }

    match /alerts/{id} { allow read: if isSignedIn(); allow write: if isResponsabile(); }
    match /vehicles/{id} { allow read: if isSignedIn(); allow write: if isResponsabile(); }
    match /vehicle_logs/{id} { allow read, write: if isSignedIn(); }
    match /documents/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /environmental_reports/{id} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isResponsabile(); }
    match /reports/{id} { allow read, create: if isSignedIn(); allow update, delete: if isAdmin(); }
    match /sanction_reports/{id} { allow read, create, update: if isSignedIn(); allow delete: if isAdmin(); }
    match /custom_pois/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /intervention_attachments/{id} { allow read, write: if isSignedIn(); }
    match /attachment_chunks/{id} { allow read, write: if isSignedIn(); }
    match /service_reports/{id} { allow read, create: if isSignedIn(); allow update, delete: if isResponsabile() || isAdmin(); }
    match /territory_controls/{id} { allow read, create, update: if isSignedIn(); allow delete: if isAdmin(); }
    match /contacts/{id} { allow read: if isSignedIn(); allow write: if isResponsabile(); }
    match /missions/{id} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isResponsabile(); }
    match /sos_duty_shifts/{id} { allow read: if isSignedIn(); allow write: if isResponsabile(); }
    match /animalia_census/{id} { allow read, write: if isSuperUser(); }
    match /access_logs/{id} { 
      allow create: if isSignedIn(); 
      allow read, delete: if isAdmin(); 
      allow update: if false; 
    }
    match /emergency_calls/{id} {
      allow read, write: if isSignedIn();
    }
    match /canine_certificates/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isResponsabile();
    }
    match /forbidden_drugs/{id} {
      allow read: if true;
      allow write: if isAdmin() || isResponsabile();
    }
    match /animal_symptoms/{id} {
      allow read: if true;
      allow write: if isAdmin() || isResponsabile();
    }
  }
}
